{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.csr.html",
  "assetGroups": [
    {
      "name": "application",
      "installMode": "prefetch",
      "resources": { "files": ["/index.csr.html", "/*.js$", "/*.css$", "/manifest.webmanifest", "/assets/images/logofe.png", "/assets/images/0*.jpg"] }
    },
    {
      "name": "images",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": { "files": ["/assets/images/**"] }
    }
  ],
  "dataGroups": [],
  "navigationRequestStrategy": "performance",
  "navigationUrls": ["/**", "!/**/*.*", "!/**/__*", "!/**/__*/*", "!/api/**"]
}
